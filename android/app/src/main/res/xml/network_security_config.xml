<?xml version="1.0" encoding="utf-8"?>
<!-- The separation server is user-hosted and usually lives on the local
     network without TLS (e.g. http://192.168.1.20:8000), so cleartext must be
     allowed. Public services (lyrics) are always reached over HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
